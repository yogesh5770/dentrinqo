# Environment Configuration Template for AKS Elite Dental Clinic
# NEVER commit production passwords or API secrets to version control.

# Application Environment
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL)
# For local dev without Postgres, SQLite file:./dev.db is used as zero-dependency fallback
DATABASE_URL="postgresql://aks_admin:aks_secure_password@localhost:5432/aks_elite_dental?schema=public"

# Session Security
SESSION_SECRET="change-this-to-a-very-long-random-secret-key-min-32-chars"
COOKIE_SECRET="change-this-cookie-signing-secret"
COOKIE_SECURE=false

# Clinic Operational Profile
CLINIC_TIMEZONE="Asia/Kolkata"
CLINIC_CURRENCY="INR"

# Storage Configuration (Local Disk or S3/MinIO)
STORAGE_DRIVER=local # local | s3
STORAGE_LOCAL_PATH="./storage/uploads"
S3_ENDPOINT="http://localhost:9000"
S3_REGION="ap-south-1"
S3_BUCKET="aks-dental-medical-records"
S3_ACCESS_KEY="aks_minio_admin"
S3_SECRET_KEY="aks_minio_secret_key"
