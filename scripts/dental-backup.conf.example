# ==============================================================================
# Off-Site Database Backup Configuration Template
# Path: /etc/dental-backup.conf (POSIX 0600, owned by root:root or postgres:postgres)
# ==============================================================================

# Enable off-site replication to S3-compatible object storage
S3_ENABLED="true"

# S3 Bucket destination (e.g., Backblaze B2 [RECOMMENDED], AWS S3, Cloudflare R2, MinIO, Wasabi)
S3_DESTINATION="s3://dentrinqo-backups-production"

# S3 Custom Endpoint URL (Leave blank for AWS standard; specify for B2/R2/MinIO/Wasabi)
# Example for Backblaze B2 (Recommended): https://s3.us-west-004.backblazeb2.com
# Example for Cloudflare R2: https://<account_id>.r2.cloudflarestorage.com
# Example for Wasabi: https://s3.ap-southeast-1.wasabisys.com
S3_ENDPOINT_URL="https://s3.us-west-004.backblazeb2.com"

# S3 Storage Region (For Backblaze B2, match your bucket region, e.g., us-west-004)
S3_REGION="us-west-004"

# Access Credentials:
# For Backblaze B2: Use restricted Application Key (keyID as AWS_ACCESS_KEY_ID, applicationKey as AWS_SECRET_ACCESS_KEY)
# Restricted to: writeFiles only, bucket: dentrinqo-backups-production
AWS_ACCESS_KEY_ID="004abc123def4560000000001"
AWS_SECRET_ACCESS_KEY="K004abcdefghijklmnopqrstuvwxyz123"

# AES-256 Symmetric Client-Side Encryption Passphrase (PBKDF2)
# The backup dump is encrypted before leaving the server.
BACKUP_ENCRYPT_PASSPHRASE="SECURE_OFFSITE_ENCRYPTION_KEY_EXAMPLE"

# Alerting Webhook (Triggered immediately upon dump, verify, encrypt, or upload failure)
ALERT_WEBHOOK_URL="https://hooks.slack.com/services/EXAMPLE/WEBHOOK/URL"
