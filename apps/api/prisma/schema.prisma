datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Clinic {
  id           String   @id @default(uuid())
  name         String
  code         String   @unique @default("AKS")
  subdomain    String?  @unique
  status       String   @default("ACTIVE") // ACTIVE, SUSPENDED, TRIAL
  planTier     String   @default("PROFESSIONAL") // STARTER, PROFESSIONAL, ENTERPRISE
  tagline      String?
  phone        String
  email        String?
  address      String
  city         String   @default("Madurai")
  state        String   @default("Tamil Nadu")
  postalCode   String   @default("625007")
  timezone     String   @default("Asia/Kolkata")
  currency     String   @default("INR")
  gstin        String?
  upiVpa       String? // UPI VPA for digital QR collections (e.g. akselitedental@icici)
  workingHours String? // JSON string
  chairCount   Int      @default(3)
  lobbySecret             String?   // 32-byte hex secret for rotating HMAC lobby code (never exposed in API)
  lobbyCodeDigits         Int       @default(4) // 4 or 6 digits
  lobbyCodeWindowSeconds  Int       @default(300) // 5 minutes (300s)
  requireLobbyCode        Boolean   @default(true)
  requireDeskConfirmation Boolean   @default(true)
  isDoctorVerified        Boolean   @default(false)
  isBillingVerified       Boolean   @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  domains                ClinicDomain[]
  displayTokens          ClinicDisplayToken[]
  users                  User[]
  accounts               Account[]
  patients               Patient[]
  appointments           Appointment[]
  consultations          Consultation[]
  consultationAmendments ConsultationAmendment[]
  dentalChartEntries     DentalChartEntry[]
  treatmentPlans         TreatmentPlan[]
  treatmentPlanItems     TreatmentPlanItem[]
  completedProcedures    CompletedProcedure[]
  prescriptions          Prescription[]
  prescriptionItems      PrescriptionItem[]
  medicalFiles           MedicalFile[]
  fileAnnotations        FileAnnotation[]
  invoices               Invoice[]
  invoiceItems           InvoiceItem[]
  payments               Payment[]
  refundAdjustments      RefundAdjustment[]
  followUps              FollowUpReminder[]
  auditLogs              AuditLog[]
  treatmentCatalogItems  TreatmentCatalogItem[]
  labOrders              LabOrder[]
  consents               PatientConsent[]
  dailyQueueSequences    DailyQueueSequence[]
  clinicSequences        ClinicSequence[]
}

model User {
  id                  String    @id @default(uuid())
  clinicId            String
  clinic              Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  email               String    @unique
  username            String?
  passwordHash        String
  fullName            String
  role                String    @default("RECEPTIONIST") // CLINIC_ADMIN, DENTIST, RECEPTIONIST, ACCOUNTANT
  phone               String?
  licenseNumber       String?
  specialization      String?
  designation         String?
  department          String?
  employeeId          String?
  permissions         String?   @default("[]")
  mustChangePassword  Boolean   @default(false)
  resetPasswordToken  String?
  resetPasswordExpiry DateTime?
  isActive            Boolean   @default(true)
  lastLoginAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  dentistAppointments Appointment[]        @relation("DentistAppointments")
  createdAppointments Appointment[]        @relation("CreatedAppointments")
  consultations       Consultation[]
  completedProcedures CompletedProcedure[]
  prescriptions       Prescription[]
  auditLogs           AuditLog[]

  @@unique([clinicId, username])
  @@index([clinicId, role])
  @@index([email])
}

model Account {
  id           String  @id @default(uuid())
  clinicId     String
  clinic       Clinic  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  phone        String // E.164 normalized: +91XXXXXXXXXX
  passwordHash String? // Nullable for guest accounts

  // Security & Lockout
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?

  // DPDP & Consent Framework
  consentDataUse  Boolean   @default(false)
  consentWhatsapp Boolean   @default(false)
  consentVersion  String?   @default("v1.0")
  consentAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patients Patient[]

  @@unique([clinicId, phone])
  @@index([clinicId, phone])
}

model Patient {
  id       String @id @default(uuid())
  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  uhid     String
  fullName String

  // Account & Family Association (Nullable for backwards compatibility)
  accountId         String?
  account           Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  relationToAccount String? // SELF, SPOUSE, CHILD, PARENT, OTHER

  // Date of Birth & Approximation
  dateOfBirth           DateTime?
  dobApproximate        Boolean   @default(false)
  age                   Int?
  gender                String
  phone                 String
  email                 String?
  address               String?
  emergencyContactName  String?
  emergencyContactPhone String?
  bloodGroup            String?
  allergies             String    @default("[]") // JSON string array
  medicalConditions     String    @default("[]") // JSON string array
  currentMedications    String    @default("[]") // JSON string array
  notes                 String?

  // Legacy Archive & Case Sheet Tracking (18,000+ Physical Patient Records)
  legacySlNo             String? // Physical Serial Number (e.g. "18470")
  guardianName           String? // Care of / Guardian (e.g. "c/o K. Palani")
  occupation             String? // Occupation (e.g. "Student (X-std)")
  legacyRegistrationDate DateTime? // Original registration date on paper card (e.g. 2016-09-26)
  legacyChiefComplaint   String? // Original chief complaint from paper card
  legacyPastHistory      String? // Past medical/dental history (PMH)
  legacyTreatmentPlan    String? // Handwritten treatment plan
  voiceNoteUrl           String? // Audio memo link
  cardPhotoUrl           String? // Physical paper card photo link
  physicalLocation       String? // Filing location: Cabinet / Shelf / Drawer

  // Duplicate Tracking & Merge Engine
  possibleDuplicate Boolean   @default(false)
  mergeSurvivingId  String? // Pointer to surviving patient if merged
  mergedAt          DateTime?
  mergedById        String?

  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  appointments        Appointment[]
  consultations       Consultation[]
  dentalChartEntries  DentalChartEntry[]
  treatmentPlans      TreatmentPlan[]
  completedProcedures CompletedProcedure[]
  prescriptions       Prescription[]
  medicalFiles        MedicalFile[]
  invoices            Invoice[]
  payments            Payment[]
  followUps           FollowUpReminder[]
  labOrders           LabOrder[]
  consents            PatientConsent[]

  @@unique([clinicId, uhid])
  @@index([clinicId, phone])
  @@index([clinicId, fullName])
  @@index([clinicId, legacySlNo])
  @@index([uhid])
  @@index([accountId])
}

model Appointment {
  id              String    @id @default(uuid())
  clinicId        String
  clinic          Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientId       String
  patient         Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  dentistId       String
  dentist         User      @relation("DentistAppointments", fields: [dentistId], references: [id])
  createdById     String
  createdBy       User      @relation("CreatedAppointments", fields: [createdById], references: [id])
  chairNumber     Int       @default(1)
  scheduledStart  DateTime
  scheduledEnd    DateTime
  durationMinutes Int       @default(30)
  reason          String
  status          String    @default("SCHEDULED") // SCHEDULED, CONFIRMED, CHECKED_IN, CALLED, IN_CHAIR, TREATED, BILLED, PAID, COMPLETED, CANCELLED, NO_SHOW, LATE, SKIPPED, STEPPED_OUT, RESCHEDULED
  checkInTime     DateTime?
  isConfirmedAtDesk Boolean   @default(false)
  confirmedAtDeskAt DateTime?
  confirmedByStaffId String?
  checkInSource   String?   @default("DESK") // "SELF_QR", "DESK", "PHONE"
  notes           String?
  isReappearance  Boolean   @default(false)
  legacySlNo      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  consultation Consultation?
  followUp     FollowUpReminder?

  @@index([clinicId, scheduledStart])
  @@index([clinicId, status, scheduledStart])
  @@index([dentistId, scheduledStart, scheduledEnd])
  @@index([patientId])
}

model Consultation {
  id                  String       @id @default(uuid())
  clinicId            String
  clinic              Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientId           String
  patient             Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  dentistId           String
  dentist             User         @relation(fields: [dentistId], references: [id])
  appointmentId       String?      @unique
  appointment         Appointment? @relation(fields: [appointmentId], references: [id])
  visitDate           DateTime     @default(now())
  visitType           String       @default("ROUTINE") // ROUTINE, REAPPEARANCE_RETURN, FOLLOW_UP, EMERGENCY
  reappearanceReason  String? // Why old archived patient reappeared today
  chiefComplaint      String
  clinicalExamination String
  diagnosis           String
  clinicalNotes       String?
  voiceNoteUrl        String? // Consultation voice recording memo
  isFinalized         Boolean      @default(false)
  finalizedAt         DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  amendments          ConsultationAmendment[]
  dentalChartEntries  DentalChartEntry[]
  treatmentPlans      TreatmentPlan[]
  completedProcedures CompletedProcedure[]
  prescriptions       Prescription[]
  medicalFiles        MedicalFile[]

  @@index([clinicId, visitDate])
  @@index([clinicId, patientId])
  @@index([patientId, visitDate])
}

model ConsultationAmendment {
  id              String       @id @default(uuid())
  clinicId        String
  clinic          Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  consultationId  String
  consultation    Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  amendedById     String
  reason          String
  previousContent String // JSON string
  newContent      String // JSON string
  amendedAt       DateTime     @default(now())

  @@index([clinicId])
  @@index([consultationId])
}

model DentalChartEntry {
  id             String        @id @default(uuid())
  clinicId       String
  clinic         Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientId      String
  patient        Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  consultationId String?
  consultation   Consultation? @relation(fields: [consultationId], references: [id])
  toothNumber    Int // FDI 11-48, 51-85
  surface        String        @default("WHOLE_TOOTH")
  condition      String // HEALTHY, CARIES, FILLED_AMALGAM, etc.
  notes          String?
  recordedById   String
  createdAt      DateTime      @default(now())

  @@index([clinicId, patientId])
  @@index([patientId, toothNumber])
}

model TreatmentPlan {
  id                  String        @id @default(uuid())
  clinicId            String
  clinic              Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientId           String
  patient             Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  consultationId      String?
  consultation        Consultation? @relation(fields: [consultationId], references: [id])
  title               String
  status              String        @default("PROPOSED")
  totalEstimatedPaise Int           @default(0) // Integer paise
  dentistNotes        String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  items TreatmentPlanItem[]

  @@index([clinicId, patientId])
  @@index([patientId])
}

model TreatmentPlanItem {
  id                 String        @id @default(uuid())
  clinicId           String
  clinic             Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  treatmentPlanId    String
  treatmentPlan      TreatmentPlan @relation(fields: [treatmentPlanId], references: [id], onDelete: Cascade)
  toothNumber        Int?
  procedureCode      String
  procedureName      String
  estimatedCostPaise Int
  status             String        @default("PLANNED")
  sequenceOrder      Int           @default(1)
  notes              String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  completedProcedure CompletedProcedure?

  @@index([clinicId])
  @@index([treatmentPlanId])
}

model CompletedProcedure {
  id                  String             @id @default(uuid())
  clinicId            String
  clinic              Clinic             @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientId           String
  patient             Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  consultationId      String?
  consultation        Consultation?      @relation(fields: [consultationId], references: [id])
  treatmentPlanItemId String?            @unique
  treatmentPlanItem   TreatmentPlanItem? @relation(fields: [treatmentPlanItemId], references: [id])
  dentistId           String
  dentist             User               @relation(fields: [dentistId], references: [id])
  toothNumber         Int?
  procedureCode       String
  procedureName       String
  notes               String?
  performedAt         DateTime           @default(now())
  isBilled            Boolean            @default(false)
  createdAt           DateTime           @default(now())

  invoiceItem InvoiceItem?

  @@index([clinicId, patientId])
  @@index([patientId])
}

model Prescription {
  id                 String        @id @default(uuid())
  clinicId           String
  clinic             Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientId          String
  patient            Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  dentistId          String
  dentist            User          @relation(fields: [dentistId], references: [id])
  consultationId     String?
  consultation       Consultation? @relation(fields: [consultationId], references: [id])
  prescriptionNumber String
  status             String        @default("DRAFT")
  instructions       String?
  dietAdvice         String?
  finalizedAt        DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  items PrescriptionItem[]

  @@unique([clinicId, prescriptionNumber])
  @@index([clinicId, patientId])
  @@index([patientId])
}

model PrescriptionItem {
  id             String       @id @default(uuid())
  clinicId       String
  clinic         Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicineName   String
  dosage         String
  form           String
  frequency      String
  durationDays   Int
  timing         String
  instructions   String?
  createdAt      DateTime     @default(now())

  @@index([clinicId])
  @@index([prescriptionId])
}

model MedicalFile {
  id             String        @id @default(uuid())
  clinicId       String
  clinic         Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientId      String
  patient        Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  consultationId String?
  consultation   Consultation? @relation(fields: [consultationId], references: [id])
  category       String
  fileName       String
  storageKey     String        @unique
  mimeType       String
  sizeBytes      Int
  sha256Hash     String
  uploadedById   String
  uploadedAt     DateTime      @default(now())

  annotations FileAnnotation[]

  @@index([clinicId, category])
  @@index([clinicId, patientId])
  @@index([patientId, category])
}

model FileAnnotation {
  id            String      @id @default(uuid())
  clinicId      String
  clinic        Clinic      @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  medicalFileId String
  medicalFile   MedicalFile @relation(fields: [medicalFileId], references: [id], onDelete: Cascade)
  pinNumber     Int
  xPercent      Float // 0 to 100% position on image
  yPercent      Float // 0 to 100% position on image
  noteText      String
  authorName    String?
  createdAt     DateTime    @default(now())

  @@index([clinicId])
  @@index([medicalFileId])
}

model Invoice {
  id            String    @id @default(uuid())
  clinicId      String
  clinic        Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientId     String
  patient       Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  invoiceNumber String
  status        String    @default("DRAFT")
  subtotalPaise Int       @default(0)
  discountPaise Int       @default(0)
  taxPaise      Int       @default(0)
  totalPaise    Int       @default(0)
  paidPaise     Int       @default(0)
  balancePaise  Int       @default(0)
  dueDate       DateTime?
  notes         String?
  createdById   String
  issuedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  items    InvoiceItem[]
  payments Payment[]
  refunds  RefundAdjustment[]

  @@unique([clinicId, invoiceNumber])
  @@index([clinicId, status])
  @@index([patientId])
  @@index([invoiceNumber])
}

model InvoiceItem {
  id                   String              @id @default(uuid())
  clinicId             String
  clinic               Clinic              @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  invoiceId            String
  invoice              Invoice             @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  completedProcedureId String?             @unique
  completedProcedure   CompletedProcedure? @relation(fields: [completedProcedureId], references: [id])
  description          String
  toothNumber          Int?
  quantity             Int                 @default(1)
  unitPricePaise       Int
  totalPaise           Int
  createdAt            DateTime            @default(now())

  @@index([clinicId])
  @@index([invoiceId])
}

model Payment {
  id              String   @id @default(uuid())
  clinicId        String
  clinic          Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  invoiceId       String
  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  patientId       String
  patient         Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  receiptNumber   String
  amountPaise     Int
  paymentMethod   String
  referenceNumber String?
  notes           String?
  recordedById    String
  receivedAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  refunds RefundAdjustment[]

  @@unique([clinicId, receiptNumber])
  @@index([clinicId, receivedAt])
  @@index([invoiceId])
  @@index([patientId])
  @@index([receiptNumber])
}

model RefundAdjustment {
  id           String   @id @default(uuid())
  clinicId     String
  clinic       Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  invoiceId    String
  invoice      Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  paymentId    String?
  payment      Payment? @relation(fields: [paymentId], references: [id])
  amountPaise  Int
  reason       String
  approvedById String
  createdAt    DateTime @default(now())

  @@index([clinicId])
  @@index([invoiceId])
}

model FollowUpReminder {
  id            String       @id @default(uuid())
  clinicId      String
  clinic        Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientId     String
  patient       Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointmentId String?      @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  scheduledDate DateTime
  type          String
  status        String       @default("PENDING")
  reminderSent  Boolean      @default(false)
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([clinicId, scheduledDate, status])
  @@index([clinicId, patientId])
  @@index([patientId])
  @@index([scheduledDate, status])
}

model AuditLog {
  id         String   @id @default(uuid())
  clinicId   String
  clinic     Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  actorRole  String?
  action     String
  entityType String
  entityId   String?
  ipAddress  String?
  userAgent  String?
  details    String? // JSON string
  createdAt  DateTime @default(now())

  @@index([clinicId, action])
  @@index([actorId, createdAt])
  @@index([entityType, entityId])
}

model TreatmentCatalogItem {
  id               String   @id @default(uuid())
  clinicId         String
  clinic           Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  code             String
  name             String
  category         String   @default("General")
  standardFeePaise Int      @default(0)
  description      String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([clinicId, code])
  @@index([clinicId, isActive])
  @@index([category])
}

model LabOrder {
  id              String    @id @default(uuid())
  clinicId        String
  clinic          Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientId       String
  patient         Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  dentistId       String?
  labName         String
  itemType        String // ZIRCONIA_CROWN, PFM_BRIDGE, EMAX_VENEER, COMPLETE_DENTURE, RPD, NIGHT_GUARD, ALIGNER, IMPLANT_ABUTMENT, ORTHO_APPLIANCE
  toothNumber     Int? // FDI tooth number (e.g. 11, 26, 46)
  shade           String? // A1, A2, A3, B1, BL1, etc.
  status          String    @default("SENT") // SENT, IN_LAB, RECEIVED, TRIAL_DONE, FITTED, CANCELLED
  sentDate        DateTime  @default(now())
  expectedDueDate DateTime?
  patientApptDate DateTime?
  costPaise       Int       @default(0)
  notes           String?
  technicianPhone String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([clinicId, status])
  @@index([patientId])
}

model PatientConsent {
  id                 String   @id @default(uuid())
  clinicId           String
  clinic             Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientId          String
  patient            Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  consentType        String // GENERAL_DENTAL, ROOT_CANAL, EXTRACTION_SURGICAL, DENTAL_IMPLANT, ORTHODONTIC, WHATSAPP_DATA
  title              String
  termsText          String
  signerName         String
  signerRelationship String   @default("SELF") // SELF, PARENT, SPOUSE, GUARDIAN
  signerPhone        String?
  signatureBase64    String // Digital signature canvas data URL
  signedAt           DateTime @default(now())
  doctorName         String?
  ipAddress          String?
  version            String   @default("1.0")
  createdAt          DateTime @default(now())

  @@index([clinicId, consentType])
  @@index([patientId])
}

model DailyQueueSequence {
  id           String   @id @default(uuid())
  clinicId     String
  clinic       Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  dateString   String
  lastSequence Int      @default(0)
  updatedAt    DateTime @default(now()) @updatedAt

  @@unique([clinicId, dateString])
  @@index([clinicId, dateString])
}

model ClinicSequence {
  id           String   @id @default(uuid())
  clinicId     String
  clinic       Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  sequenceType String   // UHID, INVOICE, RECEIPT, DAILY_QUEUE
  fiscalYear   String?  // e.g. "2026-2027" or "2026"
  currentValue Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@unique([clinicId, sequenceType, fiscalYear])
  @@index([clinicId, sequenceType])
}

model ClinicDomain {
  id        String   @id @default(uuid())
  clinicId  String
  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  domain    String   @unique // e.g. "aks.elitedental.in", "localhost:5173", "13.201.121.18"
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([clinicId])
}

model ClinicDisplayToken {
  id         String    @id @default(uuid())
  clinicId   String
  clinic     Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  name       String    // e.g. "Waiting Room TV Display 1"
  tokenHash  String    @unique // SHA-256 hash of the 32+ byte token
  lastUsedAt DateTime?
  revokedAt  DateTime?
  isRevoked  Boolean   @default(false)
  createdAt  DateTime  @default(now())

  @@index([clinicId])
}

